{
    # Enable the admin API on all interfaces at port 2019
    # Useful for dynamic configuration and live updates
    admin 0.0.0.0:2019
}

# Define a site block for your custom domain
iotchat.link {
    tls {
        issuer acme  # Use the ACME protocol (e.g. Let’s Encrypt) to automatically obtain HTTPS certificates
